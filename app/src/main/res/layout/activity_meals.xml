<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===================== -->
        <!-- HEADER -->
        <!-- ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dodaj produkt"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />


        <Button
            android:id="@+id/exportMealsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eksport spożytych"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/importMealsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import spożytych"
            android:layout_marginBottom="10dp"/>
        <!-- ===================== -->
        <!-- SELECT PRODUCT -->
        <!-- ===================== -->

        <Spinner
            android:id="@+id/productSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/selectedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brak wyboru"
            android:textSize="16sp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dodaj do zjedzonych"
            android:layout_marginBottom="20dp" />

        <!-- ===================== -->
        <!-- CONSUMED HEADER -->
        <!-- ===================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zjedzone dziś"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="10dp" />

        <!-- ===================== -->
        <!-- CONSUMED LIST -->
        <!-- ===================== -->

        <LinearLayout
            android:id="@+id/mealsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>